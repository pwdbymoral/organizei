{
  "name": "organizei",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @organizei/web dev",
    "build": "pnpm --filter @organizei/web build",
    "start": "pnpm --filter @organizei/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/testkit/tsconfig.json",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash scripts/ci/e2e-docker.sh",
    "test:a11y": "playwright test --grep @a11y",
    "test:pwa": "playwright test --grep @pwa",
    "test:visual": "playwright test --grep @visual",
    "db:generate": "pnpm --filter @organizei/database exec drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/database/scripts/migrate.ts",
    "db:check": "pnpm --filter @organizei/database exec drizzle-kit check --config drizzle.config.ts",
    "db:seed": "tsx packages/database/scripts/seed.ts",
    "admin:user:create": "tsx packages/database/scripts/admin-user.ts create",
    "admin:user:reset-password": "tsx packages/database/scripts/admin-user.ts reset-password",
    "admin:user:revoke-sessions": "tsx packages/database/scripts/admin-user.ts revoke-sessions",
    "admin:user:list": "tsx packages/database/scripts/admin-user.ts list",
    "agents:sync": "tsx scripts/agents/sync.ts",
    "agents:check": "tsx scripts/agents/check.ts",
    "agents:list": "tsx scripts/agents/list.ts",
    "security:check": "pnpm audit --prod --audit-level high",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm agents:check && pnpm db:check && pnpm build",
    "verify:e2e": "pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "jsdom": "27.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "testcontainers": "11.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
